{
  "name": "magic-tools-chrome",
  "version": "2.25.0",
  "description": "Magic Tools — developer toolbox as a Chrome extension (Manifest V3)",
  "keywords": [
    "chrome-extension",
    "developer-tools"
  ],
  "homepage": "https://freewu.github.io/magic-tools",
  "bugs": {
    "url": "https://github.com/freewu/magic-tools/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freewu/magic-tools.git"
  },
  "license": "MIT",
  "author": {
    "name": "bluefrog",
    "email": "bluefrog.wu@gmail.com",
    "url": "https://freewu.github.io"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "package": "vite build && node scripts/package.mjs",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "prettier": {
    "singleQuote": true
  },
  "jest": {
    "moduleDirectories": [
      "node_modules",
      "src"
    ],
    "moduleFileExtensions": [
      "js",
      "jsx",
      "ts",
      "tsx",
      "json"
    ],
    "moduleNameMapper": {
      "^yaml$": "<rootDir>/node_modules/yaml/dist/index.js",
      "^svgo/browser$": "<rootDir>/node_modules/svgo/dist/svgo-node.cjs",
      "\\.(jpg|jpeg|png|gif|eot|otf|webp|svg|ttf|woff|woff2|mp4|webm|wav|mp3|m4a|aac|oga)$": "<rootDir>/mocks/fileMock.js",
      "\\.(css|less|sass|scss)$": "identity-obj-proxy"
    },
    "setupFiles": [
      "<rootDir>/jest.setup.ts"
    ],
    "testEnvironment": "jsdom",
    "testEnvironmentOptions": {
      "url": "http://localhost/"
    },
    "testTimeout": 180000,
    "testPathIgnorePatterns": [
      "dist"
    ],
    "transform": {
      "\\.(ts|tsx|js|jsx)$": [
        "ts-jest",
        {
          "tsconfig": {
            "module": "commonjs",
            "skipLibCheck": true
          }
        }
      ]
    },
    "modulePathIgnorePatterns": [
      "<rootDir>/dist/",
      "<rootDir>/release/"
    ],
    "watchPathIgnorePatterns": [
      "<rootDir>/dist/",
      "<rootDir>/release/"
    ]
  },
  "dependencies": {
    "@ant-design/icons": "^5.1.0",
    "@excalidraw/excalidraw": "^0.18.1",
    "antd": "^5.5.0",
    "base-x": "^4.0.0",
    "bcryptjs": "^3.0.2",
    "bignumber.js": "^9.3.1",
    "boytacean": "^0.13.2",
    "color-convert": "^2.0.1",
    "crypto-js": "^4.1.1",
    "deepmerge": "^4.3.1",
    "fast-xml-parser": "^4.5.7",
    "figlet": "^1.11.4",
    "gifuct-js": "^2.1.2",
    "highlight.js": "^11.8.0",
    "html-to-image": "^1.11.13",
    "js-base64": "^3.7.5",
    "js-ini": "^1.6.0",
    "jsbarcode": "^3.12.3",
    "jsnes": "^2.1.0",
    "json5": "^2.2.3",
    "jsqr": "^1.4.0",
    "jszip": "^3.10.2",
    "markmap-lib": "^0.18.12",
    "markmap-view": "^0.18.12",
    "modern-gif": "^2.1.0",
    "pele": "^1.6.0",
    "pinyin-pro": "^3.15.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.8.1",
    "shiki": "^4.4.3",
    "sql-formatter": "^12.2.1",
    "svgo": "^4.1.0",
    "toml-patch": "^0.2.3",
    "vditor": "^4.0.0",
    "vtracer-wasm": "^0.1.0",
    "yaml": "^2.3.1"
  },
  "overrides": {
    "@babel/plugin-transform-runtime": "^7.29.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^13.4.0",
    "@types/chrome": "^0.1.0",
    "@types/color-convert": "^2.0.0",
    "@types/crypto-js": "^4.1.1",
    "@types/jest": "^29.4.0",
    "@types/jsbarcode": "^3.11.4",
    "@types/node": "^22.12.0",
    "@types/react": "^18.0.27",
    "@types/react-dom": "^18.0.10",
    "@types/react-test-renderer": "^18.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.4.2",
    "jest-environment-jsdom": "^29.4.2",
    "prettier": "^2.8.4",
    "react-test-renderer": "^18.2.0",
    "ts-jest": "^29.0.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.1"
  }
}
