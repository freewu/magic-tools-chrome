{
  "manifest_version": 3,
  "name": "Magic Tools - 开发者工具箱",
  "short_name": "Magic Tools",
  "version": "2.25.0",
  "description": "170+ 开发者小工具: 编解码 / 加解密 / 格式化 / 图片处理 / 生成器 / 网络查询 / 小游戏。点击工具栏图标即可打开完整工具箱。",
  "minimum_chrome_version": "105",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "打开 Magic Tools 工具箱",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "tabs",
    "storage",
    "notifications",
    "clipboardWrite"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
