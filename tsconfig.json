{
  "compilerOptions": {
    "incremental": true,
    "target": "es2021",
    "module": "es2022",
    "moduleResolution": "bundler",
    "lib": ["dom", "dom.iterable", "es2021"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "baseUrl": "./src",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "noEmit": true,
    "types": ["chrome", "node", "jest", "vite/client"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.d.ts", "assets/**/*.d.ts", "jest.setup.ts"],
  "exclude": ["node_modules", "dist", "mocks", "scripts"]
}
